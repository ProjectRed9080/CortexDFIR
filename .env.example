# GEMINI_API_KEY: Clave de la API de Google Gemini (Google AI Studio).
# Permite activar los análisis periciales avanzados y el chat forense con Gemini 3.8 Flash.
# Si se deja vacía, el sistema funciona automáticamente en modo "local_dfir_engine" (motor pericial determinista).
GEMINI_API_KEY=""

# PORT: Puerto de red donde escucha el servidor Express (Cloud Run / PaaS inyectan esta variable automáticamente).
PORT=3000

# NODE_ENV: Entorno de ejecución ('production' para despliegues).
NODE_ENV=production

# APP_URL: URL pública de la aplicación desplegada (opcional, para auto-referencias o callbacks).
APP_URL="http://localhost:3000"
